# Octoparse MCP Server example environment
# Copy this file to .env for local development. Do not commit real credentials.

# Server
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=https://mcp.octoparse.com

# Octoparse public endpoints
CLIENTAPI_BASE_URL=https://openapi.octoparse.com
OFFICIAL_SITE_URL=https://www.octoparse.com
OFFICIAL_UPGRADE_URL=https://www.octoparse.com/pricing
OFFICIAL_DOWNLOAD_URL=https://www.octoparse.com/download

# Security
ALLOWED_ORIGINS=*
TRUST_PROXY=false

# Logging
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
LOG_STRUCTURED=false

# MCP task support
MCP_TASKS_ENABLED=true
EXECUTION_TASK_POLL_INTERVAL_MS=3000
EXECUTION_TASK_RESULT_TTL_SECONDS=3600

# Optional Redis-backed session/task metadata
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
